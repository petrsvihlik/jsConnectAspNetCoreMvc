<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage settings for Microsoft.Testing.Platform, replacing coverlet's
  '-p:Include=[jsConnect.*]*' / '-p:Exclude=[xunit.*]*' MSBuild filters.
  Only the shipping jsConnect assemblies are instrumented; the test assembly and
  third-party dependencies are left out.
-->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*jsConnect\.(Core|AspNetCore|Vanilla)\.dll$</ModulePath>
      </Include>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
